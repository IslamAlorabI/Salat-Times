# Salat Times — .gitignore
#
# Rule of thumb: commit anything needed to build the app from a fresh clone.
# Ignore anything Xcode, macOS or a script regenerates.

# ── Build products ───────────────────────────────────────────────────────────
# Xcode writes these into DerivedData, not the repo, but keep the guards anyway.
build/
DerivedData/
*.o
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.app
*.xcarchive
*.moved-aside

# Output of `xcodebuild | tee`, and any other stray log.
build_output.txt
*.log

# ── Per-user Xcode state ─────────────────────────────────────────────────────
# Window positions, breakpoints, which scheme you last selected. Personal to your
# machine and a constant source of pointless diffs — the shared scheme and the
# project file itself are still tracked.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
!default.pbxuser
!default.mode1v3
!default.mode2v3
!default.perspectivev3
timeline.xctimeline
playground.xcworkspace

# ── Dependencies ─────────────────────────────────────────────────────────────
# The app has none today; these keep the repo clean if that ever changes.
.build/
.swiftpm/
Packages/
Pods/
Carthage/Build/

# ── Generated assets ─────────────────────────────────────────────────────────
# Sampled from a stock macOS icon by Tools/generate-icons.sh at run time.
# The icons it *produces* are committed — a clone must build without Python.
Tools/mask-source.png

# ── Tooling ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# Claude Code: settings.json is shared project config and IS committed.
# settings.local.json is personal overrides and is not.
.claude/settings.local.json

# ── Secrets ──────────────────────────────────────────────────────────────────
# Nothing here uses these today, but committing a signing identity is
# unrecoverable, so guard against it up front.
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
.env
.env.*
secrets.plist

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.AppleDB
.AppleDesktop
.apdisk
Network Trash Folder
Temporary Items
.com.apple.timemachine.donotpresent
